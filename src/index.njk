---
layout: base.njk
section: journal
---
<section class="intro" aria-labelledby="intro-heading">
  <div class="intro-grid">
    <div class="intro-copy">
      <p class="eyebrow"><span class="status-dot"></span>A PERSONAL JOURNAL BY {{ site.author | upper }}</p>
      <h1 id="intro-heading">{{ site.headline }}<br><em>{{ site.headlineAccent }}</em></h1>
      <p class="intro-description">{{ site.intro }}</p>
      <div class="intro-actions">
        <a class="primary-link" href="{{ '/subscribe/' | url }}">Get updates <span aria-hidden="true">↗</span></a>
        <span>Device notifications, email, or RSS. Unsubscribe anytime.</span>
      </div>
    </div>
    <aside class="intro-quote-card" data-quote-widget aria-label="Daily Quote">
      <div class="quote-card-header">
        <span class="small-label"><span class="status-dot"></span> DAILY MARGIN</span>
        <button class="quote-refresh-btn" type="button" aria-label="Shuffle quote" title="Shuffle quote" data-quote-refresh><span class="refresh-icon" aria-hidden="true">↺</span></button>
      </div>
      <blockquote class="quote-text" data-quote-text>“Somewhere, something incredible is waiting to be known.”</blockquote>
      <div class="quote-card-footer">
        <cite class="quote-author" data-quote-author>— Carl Sagan</cite>
        <span class="quote-topic-tag" data-quote-topic>Space</span>
      </div>
      <script type="application/json" id="quotes-data">{{ quotes | json | safe }}</script>
    </aside>
  </div>
  <div class="intro-bottom"><span>OBSERVATIONS, WRITINGS & THE OCCASIONAL DETOUR</span><span>EST. 2026 <span class="tiny-star">✳</span></span></div>
</section>
<div class="journal-layout">
  <section class="entries" aria-labelledby="entries-heading">
    <div class="section-heading"><h2 id="entries-heading">The journal</h2><span class="small-label">A FEW THINGS, LATELY</span></div>
    {% set featured = collections.posts | featured %}
    {% if featured %}
    <article class="featured-entry">
      {% if featured.data.image %}<a href="{{ featured.url | url }}" class="featured-image-link" tabindex="-1" aria-hidden="true"><img class="featured-image" src="{{ featured.data.image | url }}" alt="{{ featured.data.imageAlt }}" width="1400" height="933" fetchpriority="high"><span class="image-caption">A MOMENT, HELD STILL.</span></a>{% endif %}
      <div class="entry-meta"><span class="category category-{{ featured.data.category | slugify }}">{{ featured.data.category }}</span><span>{{ featured.date | dateDisplay }}</span><span class="meta-dot">·</span><span>{{ featured.templateContent | readingTime }} min read</span></div>
      <h3 class="featured-title"><a href="{{ featured.url | url }}">{{ featured.data.title }}</a></h3>
      <p class="entry-description">{{ featured.data.description }}</p>
      <a class="text-link" href="{{ featured.url | url }}">Read the entry <span aria-hidden="true">↗</span></a>
    </article>
    {% else %}<div class="empty-state"><h3>A fresh page.</h3><p>The first entry is on its way. There’s no hurry.</p></div>{% endif %}
    <div class="recent-entries">
      {% for post in collections.posts | remaining | take(3) %}
      <article class="entry-row"><div><div class="entry-meta"><span class="category category-{{ post.data.category | slugify }}">{{ post.data.category }}</span><span>{{ post.date | dateDisplay }}</span><span class="meta-dot">·</span><span>{{ post.templateContent | readingTime }} min read</span></div><h3><a href="{{ post.url | url }}">{{ post.data.title }}</a></h3><p>{{ post.data.description }}</p></div><a class="entry-arrow" href="{{ post.url | url }}" aria-label="Read {{ post.data.title }}">↗</a></article>
      {% endfor %}
    </div>
    {% if collections.posts.length %}<a class="archive-link" href="{{ '/archive/' | url }}">Wander through the archive <span aria-hidden="true">↗</span><span class="archive-count">{{ collections.posts.length }} ENTRIES SO FAR</span></a>{% endif %}
  </section>
  <aside class="sidebar" aria-label="Around this journal">
    <section class="about-card"><span class="small-label">THE PERSON IN THE MARGINS</span><div class="author-mark" aria-hidden="true">{{ site.author | first | upper }}<span>✳</span></div><h2>Hey, I’m {{ site.author }}.</h2><p>A person with a notebook and a habit of noticing things.</p><p>This is where some of those things end up.</p><a class="text-link" href="{{ '/about/' | url }}">A little more about me <span aria-hidden="true">↗</span></a></section>
    <section class="side-section"><h2 class="small-label">FOLLOW A THREAD</h2><div class="topic-list">{% for topic in site.topics %}<a href="{{ '/archive/' | url }}?topic={{ topic | urlencode }}"><span>{{ topic }}</span><span class="topic-count">{{ collections.posts | topic(topic) | length }} <span aria-hidden="true">↗</span></span></a>{% endfor %}</div></section>
    <section class="newsletter-card"><span class="small-label">A NEW PAGE, OCCASIONALLY</span><h2>Follow the journal.</h2><p>Receive a quiet note when something new is published.</p><a class="text-link" href="{{ '/subscribe/' | url }}">Get updates <span aria-hidden="true">↗</span></a></section>
    <section class="note-card"><span class="pin" aria-hidden="true"></span><h2 class="small-label">A NOTE TO SELF</h2><p>{{ site.note }}</p><span class="note-star" aria-hidden="true">✳</span></section>
    <div class="sidebar-foot"><span class="status-dot"></span>Updated when life happens.</div>
  </aside>
</div>
{% if site.showExamples %}<p class="example-notice">A journal waiting to become yours. The entries here are sample writings; replace them with your own.</p>{% endif %}
